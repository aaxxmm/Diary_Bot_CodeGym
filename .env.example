# Telegram Bot Token (получить у @BotFather)
TOKEN_TG=token_telegram

# OpenAI API Key (для GPT-функций)
TOKEN_OPENAI=token_ai

# Weather API Key (например, OpenWeatherMap)
WEATHER_APP_TOKEN=openweather_app_token

# Настройки
DEFAULT_CITY=Saint-Petersburg
DEFAULT_TIMEZONE=Europe/Moscow
ADMIN_USER_ID=0
MAX_TOKENS=1000
OPENAI_MODEL=gpt-3.5-turbo
LOG_LEVEL=INFO